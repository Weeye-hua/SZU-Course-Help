# Optional: store runtime data outside the source tree.
# Optional: skip the terminal program prompt (undergraduate or graduate).
# COURSE_SELECT_PROGRAM=graduate
# Graduate queues use DATA_DIR/graduate/accounts/<account-hash>/ and do not reuse DB_PATH.
COURSE_SELECT_DATA_DIR=./runtime-data
COURSE_SELECT_DB_PATH=./runtime-data/course_enroll.db
COURSE_SELECT_KEY_DIR=./runtime-data/keys
COURSE_SELECT_PORT=8000
COURSE_SELECT_UNKNOWN_RESPONSE_LIMIT=2000
# COURSE_SELECT_LEGACY_DATA_DIR=/path/to/one/old/release

# Full-catalog search pacing and explicit school-throttling backoff.
# Values are milliseconds; invalid values use the documented defaults.
COURSE_SELECT_CATALOG_PAGE_DELAY_MS=600
COURSE_SELECT_CATALOG_THROTTLE_RETRIES=3
COURSE_SELECT_CATALOG_THROTTLE_BACKOFF_MS=2000
COURSE_SELECT_CATALOG_CACHE_TTL_SECONDS=21600

# Optional: encrypt the locally generated Ed25519 private key.
# COURSE_SELECT_KEY_PASSPHRASE=replace-with-a-local-secret

# Optional PaddleOCR target-text fallback.
# COURSE_SELECT_USE_PADDLE_OCR=1

# Optional local UI/browser behavior.
# COURSE_SELECT_DEV=1
# COURSE_SELECT_NO_BROWSER=1
# COURSE_SELECT_BROWSER=/path/to/chromium
